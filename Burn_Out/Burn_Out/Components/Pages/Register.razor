@page "/user/register"

@inject UserManager<ApplicationUser> UserManager
@inject RoleManager<IdentityRole> RoleManager
@inject NavigationManager NavigationManager
@inject SignInManager<ApplicationUser> SignInManager
@inject ISnackbar Snackbar
@using Core.Models
@using Infrastructure.Models
@using Microsoft.AspNetCore.Identity
@using MudBlazor
@using Microsoft.AspNetCore.Identity.EntityFrameworkCore

<h3>Register</h3>

<MudPaper>
	<MudText Typo="Typo.h6">Rejestracja</MudText>

	@if (!string.IsNullOrEmpty(errorMessage))
	{
		<MudAlert Severity="Severity.Error" Class="mb-3">
			@errorMessage
		</MudAlert>
	}

	<MudForm @ref="form">
		<MudTextField Id="email" @bind-value="Email" Label="Email" Required="true"/>
		<MudTextField Id="password" @bind-Value="Password" Label="Hasło" Required="true" Password="true"/>
		<MudTextField Id="confirmPassword" @bind-value="ConfirmPassword" Label="Potwierdź hasło" Required="true" Password="true"/>
		<MudTextField Id="name" @bind-value="Name" Label="Imię" Required="true"/>
		<MudTextField Id="lastName" @bind-value="LastName" Label="Nazwisko" Required="true"/>
		<MudItem>
			<MudText>Data urodzenia: </MudText>
			<input type="date" class="form-control"
				   @bind="BirthDate" />
		</MudItem>
        <MudTextField @bind-Value="PhoneNumber" Label="Numer telefonu" Type="MudBlazor.InputType.Tel" />

		<MudButton id="registerButton" Variant="Variant.Filled" Color="Color.Primary" OnClick="RegisterUser" Disabled="@isSubmitting">Stwórz konto</MudButton>
	</MudForm>
</MudPaper>

@code {
	private MudForm form = default!;

	protected string Email = string.Empty;
	protected string Password = string.Empty;
	protected string ConfirmPassword = string.Empty;
	protected string Name = string.Empty;
	protected string LastName = string.Empty;
	protected DateTime BirthDate;
	protected int PhoneNumber;
	protected string errorMessage = string.Empty;

	private bool isSubmitting = false;

	private async Task RegisterUser()
	{
		errorMessage = string.Empty;
		isSubmitting = true;

		await form.Validate();

		var userExists = await UserManager.FindByEmailAsync(Email);

		if (userExists != null)
		{
			errorMessage = "Użytkownik już istnieje";
			isSubmitting = false;
			return;
		}

		if (Password != ConfirmPassword)
		{
			errorMessage = "Hasła nie są takie same";
			isSubmitting = false;
			return;
		}

		var user = new ApplicationUser
		{
			UserName = Email,
			Email = Email,
			EmailConfirmed = true,
			FirstName = Name,
			LastName = LastName,
			DateOfBirth = BirthDate,
			PhoneNumber = PhoneNumber

		};

		var result = await UserManager.CreateAsync(user, Password);

		if (!result.Succeeded)
		{
			// Do not attempt to assign role when user creation failed
			errorMessage = string.Join(", ", result.Errors.Select(e => e.Description));
			isSubmitting = false;
			return;
		}

		// Enforce Client role for public registration
		var roleName = UserRoles.Client.ToString();

		// Ensure role exists, create if missing
		if (!await RoleManager.RoleExistsAsync(roleName))
		{
			var createRoleResult = await RoleManager.CreateAsync(new IdentityRole(roleName));
			if (!createRoleResult.Succeeded)
			{
				// Roll back user creation to avoid inconsistent state
				await UserManager.DeleteAsync(user);
				errorMessage = "Nie udało się utworzyć roli: " + string.Join(", ", createRoleResult.Errors.Select(e => e.Description));
				isSubmitting = false;
				return;
			}
		}

		// Assign Client role only
		var roleResult = await UserManager.AddToRoleAsync(user, roleName);
		if (!roleResult.Succeeded)
		{
			await UserManager.DeleteAsync(user);
			errorMessage = "Nie udało się przypisać roli: " + string.Join(", ", roleResult.Errors.Select(e => e.Description));
			isSubmitting = false;
			return;
		}

		Snackbar.Add("Konto zostało utworzone pomyślnie");
		NavigationManager.NavigateTo("/login");
	}
}
