@using Core.Models
@using Infrastructure.Data
@using Microsoft.EntityFrameworkCore

@inject ApplicationDbContext DbContext

<h3>PresenceHistory</h3>

<MudPaper>
    <MudGrid>
        <MudCard>
            <MudCardHeader>
                <MudText Typo="Typo.h6">Dodaj pomiary</MudText>
            </MudCardHeader>
            <MudCardContent>
                <MudTable Items="@_presenceList" Loading="@_isLoading" >
                    <HeaderContent>
                        <MudTh>Ostatnia aktywność</MudTh>
                    </HeaderContent>
                    <RowTemplate>
                        <MudTd>@context.PresenceDate</MudTd>
                    </RowTemplate>
                </MudTable>
            </MudCardContent>
        </MudCard>
    </MudGrid>
</MudPaper>


@code {

    private bool _isLoading = true;
    private List<PresenceHistoryModel> _presenceList = new();

    protected override async Task OnInitializedAsync()
    {
        await GetPresenceListAsync();
    }

    private async Task GetPresenceListAsync()
    {
        try
        {
            _isLoading = true;
            _presenceList = await DbContext.PresenceHistories
                                .OrderBy(p => p.PresenceDate)
                                .ToListAsync();
            
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading presence history: {ex.Message}");
        }
        finally
        {
            _isLoading = false;
        }
    }
}
